#!/bin/sh
# 物理网卡出现时, 把环形缓冲区调到 min(网卡最大值, 1024)
# 上限是为了避免缓冲膨胀(队列过深导致跑满带宽时延迟飙升)

[ "$ACTION" = "add" ] || exit 0
[ -n "$DEVICENAME" ] || exit 0
command -v ethtool >/dev/null 2>&1 || exit 0

NIC="$DEVICENAME"
CAP=1024

[ -d "/sys/class/net/$NIC/device" ] || exit 0
[ "$(cat "/sys/class/net/$NIC/type" 2>/dev/null)" = "1" ] || exit 0

ETHTOOL_G="$(ethtool -g "$NIC" 2>/dev/null)"
[ -n "$ETHTOOL_G" ] || exit 0

RX_MAX="$(echo "$ETHTOOL_G" | awk '/RX:/ {print $2; exit}')"
TX_MAX="$(echo "$ETHTOOL_G" | awk '/TX:/ {print $2; exit}')"

pick() {
  # 非数字或 0 返回空, 否则取 min(值, CAP)
  case "$1" in
    ''|*[!0-9]*|0) return 1 ;;
  esac
  [ "$1" -gt "$CAP" ] && echo "$CAP" || echo "$1"
}

RX="$(pick "$RX_MAX")" && ethtool -G "$NIC" rx "$RX" 2>/dev/null
TX="$(pick "$TX_MAX")" && ethtool -G "$NIC" tx "$TX" 2>/dev/null

if ethtool -c "$NIC" 2>/dev/null | grep -q "Adaptive RX:"; then
  ethtool -C "$NIC" adaptive-rx on adaptive-tx on >/dev/null 2>&1
fi

logger -t net-buffer "Ring buffers for $NIC: rx=${RX:-unchanged} tx=${TX:-unchanged}"
exit 0
