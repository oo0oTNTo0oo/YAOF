#!/bin/sh
# /etc/uci-defaults/99-zz-hardening-defaults  (首次开机执行一次, 之后自动删除)
# 必须排在 99-network-defaults 之后(名字里的 zz 保证了顺序), 因为要用到 wan_ct / wan_cm
# 内容: 1) 两条 WAN 使用自己指定的 DNS  2) dnsmasq 关缓存  3) 防火墙收紧  4) SSH 与 LuCI 加固
# 不包含任何账号、密码、节点信息
#
# 说明: 本脚本不把 dnsmasq 切到 AdGuard Home 链路, 因为刚刷完机时 AdGuard Home / MosDNS / SmartDNS
#       还没有配置, 先保证能上网。三个组件都配好之后, 手动执行下面四行把链路接上:
#         uci set dhcp.@dnsmasq[0].noresolv='1'
#         uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#6353'
#         uci commit dhcp
#         /etc/init.d/dnsmasq restart

# ===== 可修改区 =====
WAN_DNS1="223.5.5.5"
WAN_DNS2="119.29.29.29"
FLOW_OFFLOAD="0"   # 1=开启软件流量分载。1G 线路通常不需要; 开启后已建立的连接会绕过 nftables 规则
# ====================

log() { logger -t hardening-defaults "$*"; }

# ---- 1. WAN 自定义 DNS(配合 99-network-defaults 里的 peerdns=0) ----
for w in wan_ct wan_cm; do
  if uci -q get "network.$w" >/dev/null; then
    uci -q delete "network.$w.dns"
    uci add_list "network.$w.dns=$WAN_DNS1"
    uci add_list "network.$w.dns=$WAN_DNS2"
  else
    log "找不到接口 $w, 跳过它的 DNS 设置"
  fi
done

# ---- 2. dnsmasq: 关闭缓存(主缓存放在 MosDNS 一层) ----
uci -q get "dhcp.@dnsmasq[0]" >/dev/null && uci set "dhcp.@dnsmasq[0].cachesize=0"

# ---- 3. 防火墙 ----
# 3a. 停用来自 WAN 的这些默认放行规则(WAN 地址在运营商 NAT 后面, 它们没有用处, 只会多暴露一点)
for s in $(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)=rule$/\1/p'); do
  case "$(uci -q get "firewall.$s.name")" in
    Allow-Ping|Allow-IGMP|Allow-IPSec-ESP|Allow-ISAKMP) uci set "firewall.$s.enabled=0" ;;
  esac
done

# 3b. 局域网设备不能直连外部 DNS(53)与 DoT/DoQ(853), 必须使用路由器的 DNS
add_block() {  # 参数: 规则名 端口
  for s in $(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)=rule$/\1/p'); do
    [ "$(uci -q get "firewall.$s.name")" = "$1" ] && return 0
  done
  r="$(uci add firewall rule)"
  uci set "firewall.$r.name=$1"
  uci set "firewall.$r.src=lan"
  uci set "firewall.$r.dest=wan"
  uci set "firewall.$r.proto=tcp udp"
  uci set "firewall.$r.dest_port=$2"
  uci set "firewall.$r.target=REJECT"
}
add_block Block-External-DNS 53
add_block Block-External-DoT 853

# 3c. 软件流量分载
uci -q get "firewall.@defaults[0]" >/dev/null && uci set "firewall.@defaults[0].flow_offloading=$FLOW_OFFLOAD"

# ---- 4. SSH 只监听局域网; LuCI 自动跳转 HTTPS ----
uci -q get "dropbear.@dropbear[0]" >/dev/null && uci set "dropbear.@dropbear[0].Interface=lan"
uci -q get "uhttpd.main" >/dev/null && uci set "uhttpd.main.redirect_https=1"

uci commit network
uci commit dhcp
uci commit firewall
uci commit dropbear
uci commit uhttpd
log "已应用"
exit 0
