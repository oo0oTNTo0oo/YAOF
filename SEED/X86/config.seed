### ============================================================
### YAOF X86 config.seed - 精简 / 纯 nftables / 安全优先
### 目标: OpenWrt 25.12, x86_64, i7-7500U, RTL8125 网卡, 双线多拨
### 注意: 带 [VERIFY] 的选项名需在检出 feeds 后用 make defconfig 核对
### ============================================================

### TARGET ###
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# GRUB 保留 2 秒, 方便需要时进入 failsafe 菜单
CONFIG_GRUB_TIMEOUT="2"
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_ZLIB_OPTIMIZE_SPEED=y

### HARDENING (编译加固) [VERIFY] ###
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_STRONG=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_2=y
CONFIG_PKG_RELRO_FULL=y

### CPU / 基础 ###
# Intel CPU 微码, 修补 CPU 层面安全漏洞
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_kmod-hwmon-coretemp=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

### NIC: RTL8125 使用内核自带的 r8169 驱动(官方源, 不引入第三方内核代码) ###
CONFIG_PACKAGE_kmod-r8169=y
# 以下为 x86 默认带的其他网卡驱动。刷机前先用 lspci -nn | grep -i ethernet
# 确认机器上所有网口都是 Realtek 8125; 若有 Intel 网口, 删掉对应行以保留驱动
# CONFIG_PACKAGE_kmod-e1000 is not set
# CONFIG_PACKAGE_kmod-e1000e is not set
# CONFIG_PACKAGE_kmod-igb is not set
# CONFIG_PACKAGE_kmod-igc is not set
# CONFIG_PACKAGE_kmod-ixgbe is not set
# CONFIG_PACKAGE_kmod-bnx2 is not set
# CONFIG_PACKAGE_kmod-tg3 is not set
# CONFIG_PACKAGE_kmod-forcedeth is not set
# CONFIG_PACKAGE_kmod-amazon-ena is not set
# CONFIG_PACKAGE_kmod-amd-xgbe is not set
# CONFIG_PACKAGE_kmod-dwmac-intel is not set

### FIREWALL: 纯 nftables (fw4) ###
CONFIG_PACKAGE_firewall4=y
# CONFIG_PACKAGE_firewall is not set
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
# 彻底不装 iptables 家族
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_iptables-nft is not set
# CONFIG_PACKAGE_iptables-legacy is not set
# CONFIG_PACKAGE_ip6tables-nft is not set
# CONFIG_PACKAGE_ip6tables-legacy is not set
# CONFIG_PACKAGE_xtables-nft is not set
# CONFIG_PACKAGE_xtables-legacy is not set
# CONFIG_PACKAGE_ebtables-nft is not set
# CONFIG_PACKAGE_arptables-nft is not set
# CONFIG_PACKAGE_ipset is not set
# CONFIG_PACKAGE_nat6 is not set

### DNS ###
# 首次开机保持 dnsmasq 提供 DNS, 保证一定能上网;
# AdGuardHome / mosdns / smartdns 的链路配好后, 再在 LuCI 里关闭 dnsmasq 的 DNS 功能
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set
# CONFIG_PACKAGE_dnsmasq_full_dnssec is not set
# CONFIG_PACKAGE_dnsmasq_full_auth is not set
# CONFIG_PACKAGE_dnsmasq_full_broken_rtc is not set

CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y

### MULTI-WAN: mwan3-nft (dl12345, 固定 commit 后从源码编译) ###
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

### PROXY: passwall2 (nftables 透明代理) [VERIFY 选项名] ###
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
# 只保留需要的核心, 其余不选以缩小攻击面
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Sing-Box=y

### LUCI ###
CONFIG_PACKAGE_luci=y
# HTTPS 管理界面 (uhttpd) [VERIFY 包名]
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-nginx is not set
# CONFIG_PACKAGE_luci-compat is not set

### TCP ###
# 注意: 主线内核的 bbr 是 BBRv1, 不是 BBRv3
CONFIG_PACKAGE_kmod-tcp-bbr=y

### ============ 可选, 按需取消注释 ============
# CONFIG_PACKAGE_luci-proto-wireguard=y     # 远程接入, 比开放端口转发更安全
# CONFIG_PACKAGE_luci-app-ddns=y            # 公网 IP 动态解析
# CONFIG_PACKAGE_ddns-scripts-cloudflare=y
# CONFIG_PACKAGE_luci-app-sqm=y             # 双线下需单独规划, 不建议默认开
